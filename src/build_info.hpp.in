#pragma once
#include <string_view>

namespace spe::build_info {
inline constexpr std::string_view version = "@PROJECT_VERSION@";
inline constexpr std::string_view revision = "@SPE_REVISION@";
inline constexpr std::string_view compiler = "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
inline constexpr std::string_view build_type = "@CMAKE_BUILD_TYPE@";
inline constexpr std::string_view flags = R"spe(@SPE_BUILD_FLAGS@)spe";
inline constexpr std::string_view platform = "@CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@";
inline constexpr std::string_view sanitizers = "@SPE_ENABLE_SANITIZERS@";
}
