+package org.springframework.samples.petclinic.owner;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+import org.springframework.test.context.ActiveProfiles;
+
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT,
+		properties = "spring.docker.compose.enabled=false")
+@ActiveProfiles("measurement-validation")
+class MeasurementValidationTests {
+
+	@LocalServerPort
+	int port;
+
+	@Test
+	void executesRealWorkWithoutChangingOwnerPage() throws Exception {
+		HttpClient client = HttpClient.newHttpClient();
+		String base = "http://127.0.0.1:" + port;
+		HttpResponse<String> before = client.send(HttpRequest.newBuilder(URI.create(base + "/owners/1")).build(),
+				HttpResponse.BodyHandlers.ofString());
+		assertThat(before.statusCode()).isEqualTo(200);
+		assertThat(before.body()).contains("George", "Franklin", "Leo");
+		HttpRequest config = HttpRequest.newBuilder(URI.create(base + "/validation/config"))
+			.header("Content-Type", "application/json")
+			.POST(HttpRequest.BodyPublishers.ofString("{\"delay_nanos\":1000000,\"cpu_iterations\":10000}"))
+			.build();
+		assertThat(client.send(config, HttpResponse.BodyHandlers.ofString()).statusCode()).isEqualTo(200);
+		long start = System.nanoTime();
+		HttpResponse<String> after = client.send(
+				HttpRequest.newBuilder(URI.create(base + "/owners/1")).timeout(Duration.ofSeconds(5)).build(),
+				HttpResponse.BodyHandlers.ofString());
+		assertThat(System.nanoTime() - start).isGreaterThanOrEqualTo(1_000_000);
+		assertThat(after.body()).isEqualTo(before.body());
+		assertThat(after.headers().firstValue("X-Validation-CPU-Iterations")).contains("10000");
+		String stats = client
+			.send(HttpRequest.newBuilder(URI.create(base + "/validation/stats")).build(),
+					HttpResponse.BodyHandlers.ofString())
+			.body();
+		assertThat(stats).contains("\"requests\":2", "\"cpuCalls\":1", "\"delayCalls\":1",
+				"\"cpuIterationsExecuted\":10000");
+		HttpRequest invalid = HttpRequest.newBuilder(URI.create(base + "/validation/config"))
+			.header("Content-Type", "application/json")
+			.POST(HttpRequest.BodyPublishers.ofString("{\"cpu_iterations\":1000001}"))
+			.build();
+		assertThat(client.send(invalid, HttpResponse.BodyHandlers.ofString()).statusCode()).isEqualTo(400);
+	}
+
+}
