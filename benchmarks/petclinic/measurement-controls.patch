+package org.springframework.samples.petclinic.owner;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+
+import org.springframework.context.annotation.Profile;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.web.servlet.HandlerInterceptor;
+import org.springframework.web.servlet.config.annotation.InterceptorRegistry;
+import org.springframework.web.servlet.config.annotation.WebMvcConfigurer;
+
+/**
+ * Local validation controls; inactive unless the measurement-validation profile is
+ * enabled.
+ */
+@RestController
+@Profile("measurement-validation")
+@RequestMapping("/validation")
+public class MeasurementValidationController implements WebMvcConfigurer {
+
+	private record Work(long delayNanos, long cpuIterations) {
+	}
+
+	private volatile Work work = new Work(0, 0);
+
+	private final AtomicLong requests = new AtomicLong();
+
+	private final AtomicLong delayCalls = new AtomicLong();
+
+	private final AtomicLong cpuCalls = new AtomicLong();
+
+	private final AtomicLong iterationsExecuted = new AtomicLong();
+
+	private volatile long checksum;
+
+	@Override
+	public void addInterceptors(InterceptorRegistry registry) {
+		registry.addInterceptor(new HandlerInterceptor() {
+			@Override
+			public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler)
+					throws InterruptedException {
+				Work current = work;
+				long sequence = requests.incrementAndGet();
+				if (current.delayNanos() > 0) {
+					delayCalls.incrementAndGet();
+					Thread.sleep(current.delayNanos() / 1_000_000, (int) (current.delayNanos() % 1_000_000));
+				}
+				if (current.cpuIterations() > 0) {
+					long value = sequence ^ 0x9e3779b97f4a7c15L;
+					for (long i = 0; i < current.cpuIterations(); i++) {
+						value = Long.rotateLeft(value ^ i, 13) * 0x9e3779b97f4a7c15L;
+					}
+					checksum = value;
+					cpuCalls.incrementAndGet();
+					iterationsExecuted.addAndGet(current.cpuIterations());
+				}
+				response.setHeader("X-Validation-Delay-Nanos", Long.toString(current.delayNanos()));
+				response.setHeader("X-Validation-CPU-Iterations", Long.toString(current.cpuIterations()));
+				return true;
+			}
+		}).addPathPatterns("/owners/1");
+	}
+
+	@PostMapping("/config")
+	public Map<String, Object> configure(@RequestBody Map<String, Long> configuration) {
+		long delay = configuration.getOrDefault("delay_nanos", 0L);
+		long iterations = configuration.getOrDefault("cpu_iterations", 0L);
+		if (delay < 0 || delay > 20_000_000 || iterations < 0 || iterations > 1_000_000) {
+			throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Validation workload exceeds bounded limits");
+		}
+		work = new Work(delay, iterations);
+		return stats();
+	}
+
+	@GetMapping("/stats")
+	public Map<String, Object> stats() {
+		Work current = work;
+		return Map.of("requests", requests.get(), "delayCalls", delayCalls.get(), "cpuCalls", cpuCalls.get(),
+				"cpuIterationsExecuted", iterationsExecuted.get(), "checksum", checksum, "delay_nanos",
+				current.delayNanos(), "cpu_iterations", current.cpuIterations());
+	}
+
+}
