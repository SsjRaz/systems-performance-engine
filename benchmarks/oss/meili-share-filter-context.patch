+    #[test]
+    fn owned_in_preserves_context_and_modified_tokens() {
+        let source = String::from("example filter");
+        let other = String::from("different input");
+        let field = Token::from(Span::new_extra("field", source.as_str()));
+        let value = Token::from(Span::new_extra("value", source.as_str()))
+            .with_modified_fragment(Some("modified".to_owned()));
+        let foreign = Token::from(Span::new_extra("other", other.as_str()));
+        let condition = IndexFilterCondition::In {
+            fid: field,
+            els: vec![value.clone(), value, foreign],
+        }
+        .into_owned();
+        drop(source);
+        drop(other);
+        let IndexFilterCondition::In { fid, els } = condition else { unreachable!() };
+        assert_eq!(fid.extra(), "example filter");
+        assert_eq!((els[0].original_fragment(), els[0].fragment()), ("value", "modified"));
+        assert_eq!(els[0].extra(), "example filter");
+        assert!(std::ptr::eq(els[0].extra(), els[1].extra()));
+        assert_eq!(els[2].extra(), "different input");
+        assert_eq!(els[0].clone().into_owned().get_utf8_column(), None);
+    }
